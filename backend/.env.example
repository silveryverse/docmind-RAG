# Copy to .env and fill in what you need. Everything here is optional:
# with no keys, DocMind runs offline using the extractive answer fallback.

# --- Database -------------------------------------------------------------
# Leave unset to start an embedded PostgreSQL (with pgvector) under DATA_DIR.
# Set to use a managed instance; the schema auto-creates the vector extension.
# DATABASE_URL=postgresql://docmind:docmind@localhost:5432/docmind

# --- Language model -------------------------------------------------------
# auto (default) picks openai, then anthropic, then extractive.
# LLM_PROVIDER=auto

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint
# OPENAI_MODEL=gpt-4.1-mini

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Retrieval ------------------------------------------------------------
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_DIM=384
# RERANK_ENABLED=true
# TOP_K=6
# MIN_RERANK_SCORE=-7.0

# --- Ingestion ------------------------------------------------------------
# CHUNK_TARGET_CHARS=550
# OCR_MIN_CHARS=40
# OCR_DPI=150
# MAX_UPLOAD_MB=50

# --- Misc -----------------------------------------------------------------
# DATA_DIR=./data
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
